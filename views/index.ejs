<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Качественные вязаные вещи для вашего гардероба. Свитера, шапки, шарфы и другие изделия ручной работы.">
    <meta name="keywords" content="вязаные вещи, свитера, шапки, шарфы, ручная работа">
    <title><%= title %></title>
    
    <!-- Preconnect для оптимизации загрузки шрифтов -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Загрузка шрифтов с display=swap для оптимизации -->
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Основные стили -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="header">
        <nav class="nav">
            <div class="logo">Text Title</div>
            <ul class="nav-menu">
                <li><a href="#home" class="nav-link active">Главная страница</a></li>
                <li><a href="#products" class="nav-link">Каталог</a></li>
                <li><a href="#about" class="nav-link">Обо мне</a></li>
                <li><a href="#contact" class="nav-link">Связь</a></li>
            </ul>
            <div class="cart-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="cart-count">0 P</span>
            </div>
        </nav>
    </header>

    <main>
        <!-- Секция визитка / Главная -->
        <section id="home" class="hero">
            <div class="hero-slider">
                <div class="hero-slide active">
                    <div class="hero-image"></div>
                    <div class="hero-content">
                        <h1 class="hero-title">Example 1</h1>
                        <a href="#products" class="btn btn-hero">Text preview</a>
                    </div>
                </div>
                <div class="hero-slide">
                    <div class="hero-image"></div>
                    <div class="hero-content">
                        <h1 class="hero-title">Example 2</h1>
                        <a href="#products" class="btn btn-hero">Text preview</a>
                    </div>
                </div>
                <div class="hero-slide">
                    <div class="hero-image"></div>
                    <div class="hero-content">
                        <h1 class="hero-title">Example 3</h1>
                        <a href="#products" class="btn btn-hero">Text preview</a>
                    </div>
                </div>
            </div>
            <div class="hero-controls">
                <button class="hero-arrow hero-arrow-left" aria-label="Предыдущий слайд">‹</button>
                <div class="hero-indicators">
                    <span class="indicator active" data-slide="0"></span>
                    <span class="indicator" data-slide="1"></span>
                    <span class="indicator" data-slide="2"></span>
                </div>
                <button class="hero-arrow hero-arrow-right" aria-label="Следующий слайд">›</button>
            </div>
        </section>

        <!-- Секция О нас -->
        <section id="about" class="about">
            <div class="container">
                <h2>Text title</h2>
                <p>Text title</p>
            </div>
        </section>

        <!-- Секция Товары / Лендинг -->
        <section id="products" class="products">
            <div class="container">
                <h2 class="section-title">Text title</h2>
                <div class="products-grid" id="productsGrid">
                    <% products.forEach(product => { %>
                        <div class="product-card">
                            <div class="product-image"><%= product.image %></div>
                            <div class="product-info">
                                <h3 class="product-title"><%= product.name %></h3>
                                <p class="product-description"><%= product.description %></p>
                                <div class="product-price"><%= product.price %></div>
                                <a href="/buy/<%= product.id %>" class="btn btn-buy" target="_blank">
                                    Text title
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Секция Контакты -->
        <section id="contact" class="contact">
            <div class="container">
                <h2>Связь</h2>
                <div class="contact-info">
                    <p>Email: example</p>
                    <p>Telegram: example</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; Text title</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>
